# Server-Side Secret: Required for backend Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# NEVER expose this key to client-side code or prefix with VITE_.
GEMINI_API_KEY=

# Server-Side Environment: URL where this applet is hosted.
APP_URL=

# Client-Safe Configuration: Firebase Web API configuration for browser/client use.
# These values identify the Firebase project in the browser and are not server secrets.
# In Vite, these can be set via VITE_* environment variables or via firebase-applet-config.json.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""
